{
  "name": "react-truncate-inside",
  "version": "1.1.0",
  "description": "React component that truncates text in the middle with an ellipsis, so a long string such as a file name, hash or wallet address keeps both its beginning and its end visible.",
  "main": "lib/index.js",
  "module": "es/index.js",
  "types": "es/index.d.ts",
  "files": [
    "lib",
    "es",
    "README.zh-CN.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build:lib": "babel src --out-dir lib --extensions .ts,.tsx",
    "build:es": "tsc",
    "build": "npm run build:lib && npm run build:es",
    "test": "vitest run",
    "storybook": "storybook dev -p 6006",
    "storybook-docs": "storybook dev --docs",
    "build:doc": "storybook build --docs -o storybook-static",
    "build:site": "npm run build:doc && rm -rf _site && mkdir -p _site/storybook && cp -R public/. _site/ && cp -R storybook-static/. _site/storybook/"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zhiyuc123/react-truncate-inside.git"
  },
  "bugs": {
    "url": "https://github.com/zhiyuc123/react-truncate-inside/issues"
  },
  "homepage": "https://github.com/zhiyuc123/react-truncate-inside",
  "license": "MIT",
  "author": "zhiyuc123",
  "keywords": [
    "react",
    "react-component",
    "truncate",
    "truncate-text",
    "truncate-middle",
    "truncate-inside",
    "middle-truncation",
    "middle-ellipsis",
    "ellipsis",
    "text-overflow",
    "filename"
  ],
  "peerDependencies": {
    "react": ">=16.8.0"
  },
  "devDependencies": {
    "@babel/cli": "^7.21.0",
    "@babel/core": "^7.21.0",
    "@babel/preset-env": "^7.20.2",
    "@babel/preset-react": "^7.18.6",
    "@babel/preset-typescript": "^7.21.0",
    "@storybook/addon-actions": "^7.0.22",
    "@storybook/addon-essentials": "^7.0.22",
    "@storybook/addon-interactions": "^7.0.22",
    "@storybook/addon-links": "^7.0.22",
    "@storybook/react": "^7.0.22",
    "@storybook/react-webpack5": "^7.0.22",
    "@storybook/testing-library": "^0.2.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^18.0.28",
    "@typescript-eslint/eslint-plugin": "^5.54.0",
    "@typescript-eslint/parser": "^5.54.0",
    "babel-loader": "^8.3.0",
    "eslint": "^8.35.0",
    "eslint-config-prettier": "^8.7.0",
    "eslint-plugin-react": "^7.32.2",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-storybook": "^0.6.12",
    "jsdom": "^30.1.2",
    "prettier": "2.8.4",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "storybook": "^7.0.22",
    "typescript": "^4.9.5",
    "vitest": "^5.0.4"
  }
}
